{
  "name": "musicshare",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npm run build:server:watch\"",
    "dev:client": "vite build --mode development --watch",
    "dev:server": "nodemon dist/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --mode production",
    "build:server": "tsc",
    "build:server:watch": "tsc -w",
    "start": "node dist/index.js",
    "migrate": "mikro-orm migration:create",
    "migrate:up": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down",
    "migrate:latest": "mikro-orm migration:latest",
    "migrate:rollback": "mikro-orm migration:rollback"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mikro-orm/core": "^6.3.7",
    "@mikro-orm/postgresql": "^6.3.7",
    "@mikro-orm/reflection": "^6.3.7",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "musicbrainz-api": "^0.18.2",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "spotify-api.js": "^9.2.5",
    "ts-node": "^10.9.2",
    "ytdl-core": "^4.11.5",
    "ytsr": "^3.8.4"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.3.7",
    "@mikro-orm/migrations": "^6.3.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.3",
    "@types/node-fetch": "^2.6.11",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "simple-icons": "^13.8.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}